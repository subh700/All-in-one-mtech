# systemd unit — runs the bot 24/7 in daemon mode on a Linux VPS.
#   sudo cp deploy/dhan-autotrader.service /etc/systemd/system/
#   (edit User= and WorkingDirectory= below)
#   sudo systemctl daemon-reload && sudo systemctl enable --now dhan-autotrader
#   journalctl -u dhan-autotrader -f
[Unit]
Description=Dhan auto-trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
WorkingDirectory=/home/trader/All-in-one-mtech
ExecStart=/home/trader/All-in-one-mtech/.venv/bin/python -m dhan_autotrader --daemon --dashboard
# Live trading: TRADING_MODE=live in .env and append --confirm-live to ExecStart
Restart=always
RestartSec=30
# Ctrl+C equivalent so open positions are squared off on stop
KillSignal=SIGINT
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
