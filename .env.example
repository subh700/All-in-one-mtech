# ---- Dhan credentials (from web.dhan.co -> My Profile -> Access DhanHQ APIs) ----
DHAN_CLIENT_ID=1000000000
DHAN_ACCESS_TOKEN=paste_your_access_token_here

# ---- Mode: paper (simulated, default) or live (REAL orders) ----
TRADING_MODE=paper

# ---- Instruments: SYMBOL:SECURITY_ID:EXCHANGE_SEGMENT, comma separated ----
# Security IDs: https://images.dhan.co/api-data/api-scrip-master.csv
# 1333 = HDFCBANK, 2885 = RELIANCE, 11536 = TCS (NSE_EQ)
INSTRUMENTS=HDFCBANK:1333:NSE_EQ,RELIANCE:2885:NSE_EQ

# ---- Strategy (EMA crossover on closed candles) ----
CANDLE_INTERVAL_MIN=5
FAST_EMA=9
SLOW_EMA=21
ALLOW_SHORT=false

# ---- Risk management ----
CAPITAL_PER_TRADE=10000
STOP_LOSS_PCT=1.0
TARGET_PCT=2.0
MAX_TRADES_PER_DAY=6
MAX_DAILY_LOSS=1000
MAX_OPEN_POSITIONS=2

# ---- Session (IST) ----
ENTRY_START=09:30
ENTRY_END=14:45
SQUARE_OFF=15:15
POLL_SECONDS=20

# ---- Strategy selector: equity (stocks) or nifty-options ----
STRATEGY=equity

# ---- NIFTY options (used when STRATEGY=nifty-options) ----
# Signal = EMA crossover on the NIFTY index; bullish -> BUY OTM CE, bearish -> BUY OTM PE.
# CAPITAL_PER_TRADE, MAX_TRADES_PER_DAY, MAX_DAILY_LOSS, timings and EMA settings above also apply.
OPT_UNDERLYING=NIFTY:13:IDX_I
OPT_LOT_SIZE=65            # CHECK the current NSE lot size before going live
OPT_MAX_LOTS=1
OPT_STRIKE_STEP=50
OPT_STRIKE_OFFSET=1        # OTM buying: 1=one strike OTM (50 pts), 2=two OTM (100 pts); 0=ATM
OPT_EXPIRY_INDEX=0         # 0=nearest weekly expiry
OPT_SKIP_EXPIRY_DAY=true   # avoid expiry-day theta/gamma; use next expiry instead
OPT_SL_PCT=25              # stop-loss, % of premium
OPT_TARGET_PCT=50          # target, % of premium
OPT_MIN_PREMIUM=10         # ignore contracts cheaper than this
