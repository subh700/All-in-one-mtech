# ---- Dhan credentials (from web.dhan.co -> My Profile -> Access DhanHQ APIs) ----
DHAN_CLIENT_ID=1000000000
# Option A: paste a token (expires; must be refreshed by hand)
DHAN_ACCESS_TOKEN=paste_your_access_token_here
# Option B (recommended for daily auto-trading): automatic login with PIN + TOTP.
# Enable TOTP on Dhan (Profile -> Security / DhanHQ APIs), copy the TOTP *secret* (the text
# behind the QR code). When both are set the bot logs in itself every morning.
DHAN_PIN=
DHAN_TOTP_SECRET=

# ---- Mode: paper (simulated, default) or live (REAL orders) ----
TRADING_MODE=paper

# ---- What to trade: equity (stocks) or options (index OTM CE/PE buying) ----
STRATEGY=options

# ---- Entry signal: ema | supertrend | rsi | vwap | orb ----
# Comma-separate to require confirmation: the FIRST signal triggers, the others must agree.
#   SIGNAL=supertrend,rsi   -> take Supertrend flips only when RSI is on the same side of 50
#   SIGNAL=ema,vwap         -> take EMA crosses only when price is on the same side of VWAP
SIGNAL=ema
CANDLE_INTERVAL_MIN=5
FAST_EMA=9                 # ema
SLOW_EMA=21
ST_PERIOD=10               # supertrend
ST_MULT=3
RSI_PERIOD=14              # rsi: bullish when RSI crosses above RSI_BUY, bearish below RSI_SELL
RSI_BUY=60
RSI_SELL=40
ORB_MINUTES=15             # orb: opening range from 09:15 (multiple of CANDLE_INTERVAL_MIN)

# ---- Shared risk management ----
CAPITAL_PER_TRADE=10000
MAX_TRADES_PER_DAY=6
MAX_DAILY_LOSS=1000        # across everything; bot squares off and halts when hit
MAX_OPEN_POSITIONS=2
MAX_RISK_PER_TRADE=0       # ₹ max loss at stop-loss per trade; qty/lots are reduced to fit (0 = off)
DAILY_PROFIT_TARGET=0      # ₹ — book everything and stop for the day once reached (0 = off)
MAX_CONSECUTIVE_LOSSES=0   # stop for the day after N losing trades in a row (0 = off)
COOLDOWN_AFTER_LOSS_MIN=0  # no new entries for N minutes after a losing trade (0 = off)
SLIPPAGE_PCT=0.05          # backtest only: % of price lost on each fill

# ---- Session (IST) ----
ENTRY_START=09:30
ENTRY_END=14:45
SQUARE_OFF=15:15
POLL_SECONDS=20

# ---- Index options (STRATEGY=options) ----
OPT_INDICES=NIFTY          # any of: NIFTY,BANKNIFTY,FINNIFTY,MIDCPNIFTY,SENSEX
OPT_MAX_LOTS=1
OPT_STRIKE_OFFSET=1        # OTM buying: 1 = one strike OTM, 2 = two OTM; 0 = ATM
OPT_EXPIRY_INDEX=0         # 0 = nearest expiry
OPT_SKIP_EXPIRY_DAY=true   # on expiry day use the next expiry
OPT_SL_PCT=25              # stop-loss, % of premium
OPT_TARGET_PCT=50          # target, % of premium (0 = no target, exit only via trailing stop)
OPT_TRAIL_TRIGGER_PCT=20   # trailing starts when premium is up 20% (0 = off)
OPT_TRAIL_PCT=15           # then SL trails 15% below the highest premium (never below entry)
OPT_MIN_PREMIUM=10         # skip contracts cheaper than this
# Lot size / strike step overrides — CHECK current exchange lot sizes before going live:
# OPT_LOT_SIZE_NIFTY=65
# OPT_LOT_SIZE_BANKNIFTY=30
# OPT_LOT_SIZE_FINNIFTY=60
# OPT_LOT_SIZE_MIDCPNIFTY=120
# OPT_LOT_SIZE_SENSEX=20
# OPT_STRIKE_STEP_BANKNIFTY=100

# ---- Equity (STRATEGY=equity) ----
# SYMBOL:SECURITY_ID:EXCHANGE_SEGMENT, comma separated. IDs: https://images.dhan.co/api-data/api-scrip-master.csv
INSTRUMENTS=HDFCBANK:1333:NSE_EQ,RELIANCE:2885:NSE_EQ
STOP_LOSS_PCT=1.0
TARGET_PCT=2.0
ALLOW_SHORT=false
TRAIL_TRIGGER_PCT=0        # e.g. 1 = start trailing at +1% (0 = off)
TRAIL_PCT=0                # e.g. 0.5 = trail 0.5% below the best price

# ---- Telegram alerts (optional) ----
# 1) Message @BotFather -> /newbot -> copy the token
# 2) Send any message to your bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COMMANDS=true     # control the bot from Telegram: /status /pnl /pause /resume /squareoff /stop

# ---- Web dashboard (--dashboard / --dashboard-only) ----
DASHBOARD_HOST=127.0.0.1   # keep local; for remote access use an SSH tunnel (see README)
DASHBOARD_PORT=8050
DASHBOARD_PASSWORD=        # REQUIRED if DASHBOARD_HOST is not 127.0.0.1 (browser login, any username)
